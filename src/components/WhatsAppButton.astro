<style>
  .wa-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(30, 20, 10, 0.28);
    z-index: 2147482900;
    transition: transform 0.2s ease;
  }
  .wa-float:hover {
    transform: scale(1.06);
  }
  @media (max-width: 480px) {
    .wa-float {
      width: 52px;
      height: 52px;
      bottom: 16px;
      right: 16px;
    }
  }
</style>

---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { categories, products } from "../data/products";

const waFor = (product: string) =>
  `https://wa.me/21628897456?text=${encodeURIComponent(
    `Bonjour, je suis intéressé(e) par : ${product}. Est-il disponible ?`
  )}`;

const norm = (s: string) =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "");
---

<Layout
  title="Boutique — Nedra Bellahmer | Parfums, Soins & Soins Intimes VIF"
  description="Découvrez la sélection Nedra Bellahmer : parfums VIF, gels douche, soins visage et soins intimes — à commander sur WhatsApp."
  path="/produits"
>
  <header class="shop-header">
    <div class="container shop-header__inner reveal">
      <span class="eyebrow">La boutique</span>
      <h1>Nos produits</h1>
      <p>
        Une sélection resserrée, choisie avec soin — parfums, soins du corps, soins du
        visage et soins intimes VIF. Chaque commande se fait simplement, par message.
      </p>
    </div>
  </header>

  <!-- TOOLBAR: search + filters -->
  <div class="shop-toolbar container reveal reveal-delay-1">
    <label class="shop-search" for="product-search">
      <Icon name="search" size={17} />
      <input
        type="text"
        id="product-search"
        placeholder="Rechercher un produit..."
        autocomplete="off"
      />
    </label>

    <div class="shop-filters" id="shop-filters" role="tablist" aria-label="Filtrer par catégorie">
      {
        categories.map((c) => (
          <button
            type="button"
            class="filter-pill"
            data-filter={c.slug}
            role="tab"
            aria-selected={c.slug === "tous" ? "true" : "false"}
          >
            {c.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- PRODUCT GRID -->
  <section class="container shop-grid-wrap">
    <div class="shop-grid" id="shop-grid">
      {
        products.map((p) => (
          <article
            class:list={["product-card", p.feature && "product-card--feature"]}
            data-category={p.category}
            data-name={norm(p.name)}
          >
            <a class="product-card__image" href={`/produits/${p.slug}`} aria-label={`Voir ${p.name}`}>
              <Image src={p.img} alt={p.name} width={512} height={512} quality={80} loading="lazy" />
            </a>
            <div class="product-card__body">
              <span class="product-card__tag">{p.categoryLabel}</span>
              <h3><a href={`/produits/${p.slug}`}>{p.name}</a></h3>

              <button
                type="button"
                class="product-card__toggle"
                aria-expanded="false"
              >
                En savoir plus
                <Icon name="chevron-down" size={14} />
              </button>
              <div class="product-card__more">
                <div>
                  <p>{p.desc}</p>
                </div>
              </div>

              <a
                class="product-card__cta"
                href={waFor(p.name)}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="send" size={14} /> Commander sur WhatsApp
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="shop-empty" id="shop-empty" hidden>
      Aucun produit ne correspond à votre recherche.
    </p>
  </section>

  <section class="closing-cta">
    <div class="container closing-cta__inner reveal">
      <h2>Vous ne trouvez pas ce que vous cherchez ?</h2>
      <p>Écrivez-nous, nous vous conseillons selon vos envies.</p>
      <a class="btn btn-primary" href="/contact">
        Nous contacter <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <script>
    const grid = document.getElementById("shop-grid");
    const cards = Array.from(grid?.querySelectorAll<HTMLElement>(".product-card") ?? []);
    const pills = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".filter-pill")
    );
    const searchInput = document.getElementById("product-search") as HTMLInputElement | null;
    const emptyState = document.getElementById("shop-empty");

    let activeFilter = "tous";

    const normalize = (s: string) =>
      s
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "");

    function cardShouldShow(card: HTMLElement) {
      const query = normalize(searchInput?.value.trim() ?? "");
      const matchesCategory =
        activeFilter === "tous" || card.dataset.category === activeFilter;
      const matchesSearch = !query || (card.dataset.name ?? "").includes(query);
      return matchesCategory && matchesSearch;
    }

    // Fires only when a fade-out transition actually finishes with the card still
    // meant to be hidden — avoids racing a guessed setTimeout against fast filter/search input.
    cards.forEach((card) => {
      card.addEventListener("transitionend", (e) => {
        if (e.propertyName === "opacity" && card.classList.contains("is-hiding")) {
          card.style.display = "none";
        }
      });
    });

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const shouldShow = cardShouldShow(card);

        if (shouldShow) {
          visibleCount++;
          if (card.style.display === "none") card.style.display = "";
          requestAnimationFrame(() => {
            if (cardShouldShow(card)) card.classList.remove("is-hiding");
          });
        } else {
          card.classList.add("is-hiding");
        }
      });

      emptyState?.toggleAttribute("hidden", visibleCount !== 0);
    }

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        activeFilter = pill.dataset.filter ?? "tous";
        pills.forEach((p) => p.setAttribute("aria-selected", String(p === pill)));
        pills.forEach((p) => p.classList.toggle("active", p === pill));
        applyFilters();
      });
    });

    searchInput?.addEventListener("input", applyFilters);

    document.querySelectorAll<HTMLButtonElement>(".product-card__toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const more = btn.nextElementSibling as HTMLElement | null;
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!expanded));
        more?.classList.toggle("open", !expanded);
        btn.classList.toggle("open", !expanded);
      });
    });

    const initialHash = window.location.hash.replace("#", "");
    if (initialHash) {
      const match = pills.find((p) => p.dataset.filter === initialHash);
      if (match) match.click();
    }

    // set initial active pill styling
    pills.find((p) => p.dataset.filter === activeFilter)?.classList.add("active");
  </script>

  <style>
    .shop-header {
      padding: 64px 24px 0;
    }
    .shop-header__inner {
      max-width: 620px;
      margin: 0 auto;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
    .shop-header__inner h1 {
      font-size: clamp(2.2rem, 7vw, 3rem);
    }
    .shop-header__inner p {
      color: var(--ink-soft);
      font-size: 15.5px;
      line-height: 1.75;
    }

    /* TOOLBAR */
    .shop-toolbar {
      margin-top: 44px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      align-items: center;
    }
    .shop-search {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      max-width: 380px;
      padding: 12px 18px;
      border: 1px solid var(--line);
      border-radius: 30px;
      background: var(--white);
      color: var(--ink-soft);
      transition: border-color 0.2s ease;
    }
    .shop-search:focus-within {
      border-color: var(--accent);
    }
    .shop-search input {
      border: none;
      outline: none;
      font-family: var(--font-body);
      font-size: 14px;
      width: 100%;
      background: transparent;
      color: var(--ink);
    }
    .shop-filters {
      display: flex;
      gap: 10px;
      flex-wrap: nowrap;
      overflow-x: auto;
      max-width: 100%;
      padding: 2px 4px 10px;
      scrollbar-width: thin;
    }
    .filter-pill {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      padding: 9px 20px;
      border: 1px solid var(--line);
      border-radius: 30px;
      background: transparent;
      font-family: var(--font-body);
      font-size: 12.5px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-weight: 500;
      color: var(--ink-soft);
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }
    .filter-pill:hover {
      border-color: var(--accent);
      color: var(--accent-dark);
    }
    .filter-pill.active {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--white);
    }

    @media (min-width: 720px) {
      .shop-toolbar {
        flex-direction: row;
        justify-content: space-between;
      }
      .shop-filters {
        overflow-x: visible;
        flex-wrap: wrap;
        padding-bottom: 0;
      }
    }

    /* GRID */
    .shop-grid-wrap {
      padding: 48px 24px 40px;
    }
    .shop-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 22px;
    }
    @media (min-width: 620px) {
      .shop-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (min-width: 980px) {
      .shop-grid {
        grid-template-columns: repeat(3, 1fr);
        grid-auto-flow: dense;
      }
      .product-card--feature {
        grid-column: span 2;
      }
      .product-card--feature .product-card__image {
        aspect-ratio: 21 / 10;
      }
    }

    .product-card {
      background: var(--white);
      border: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.25s ease;
      animation: card-in 0.5s ease backwards;
    }
    @keyframes card-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .product-card:hover {
      box-shadow: 0 14px 34px rgba(36, 29, 25, 0.1);
    }
    .product-card.is-hiding {
      opacity: 0;
      transform: scale(0.96);
    }
    @media (prefers-reduced-motion: reduce) {
      .product-card {
        animation: none;
      }
    }

    .product-card__image {
      position: relative;
      background: #f3e6de;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .product-card__image img {
      width: 74%;
      height: 74%;
      object-fit: contain;
      transition: transform 0.5s ease;
    }
    .product-card:hover .product-card__image img {
      transform: scale(1.06);
    }

    .product-card__body {
      padding: 22px 24px 26px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }
    .product-card__tag {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--accent-dark);
    }
    .product-card__body h3 {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 2px;
    }
    .product-card__body h3 a {
      transition: color 0.2s ease;
    }
    .product-card__body h3 a:hover {
      color: var(--accent-dark);
    }

    .product-card__toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: none;
      padding: 0;
      font-family: var(--font-body);
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--ink-soft);
      cursor: pointer;
      width: fit-content;
    }
    .product-card__toggle svg {
      transition: transform 0.3s ease;
    }
    .product-card__toggle.open svg {
      transform: rotate(180deg);
    }
    .product-card__more {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.35s ease;
    }
    .product-card__more > div {
      overflow: hidden;
    }
    .product-card__more.open {
      grid-template-rows: 1fr;
    }
    .product-card__more p {
      font-size: 13.5px;
      line-height: 1.7;
      color: var(--ink-soft);
      padding-top: 10px;
    }

    .product-card__cta {
      margin-top: auto;
      padding-top: 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--accent-dark);
      width: fit-content;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s ease;
    }
    .product-card__cta:hover {
      border-color: var(--accent-dark);
    }

    .shop-empty {
      text-align: center;
      padding: 60px 20px;
      color: var(--ink-soft);
      font-family: var(--font-display);
      font-style: italic;
      font-size: 20px;
    }

    /* CLOSING CTA */
    .closing-cta {
      background: var(--ink);
      padding: 90px 24px;
      margin-top: 20px;
    }
    .closing-cta__inner {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .closing-cta__inner h2 {
      color: var(--white);
      font-size: clamp(1.9rem, 6vw, 2.4rem);
    }
    .closing-cta__inner p {
      color: #cfc3b4;
      font-size: 15px;
    }
  </style>
</Layout>
